{
  "name": "dealership-alpha",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "balance": "tsx scripts/balance-harness/cli.ts",
    "gen:fixtures": "tsx scripts/balance-harness/gen-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "hooks:test": "node .claude/hooks/selftest.mjs",
    "hooks:scan": "node .claude/hooks/scan-module-boundary.mjs",
    "build": "npx eas-cli build",
    "tunnel:reset": "npm uninstall @expo/ngrok && rimraf node_modules/@expo/ngrok node_modules/ngrok && npm install -D @expo/ngrok@latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.0.3",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "expo-font": "$expo-font"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  }
}
