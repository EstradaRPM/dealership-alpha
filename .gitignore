# local env files
.env*.local

# Claude Code: ignore everything personal/local, but share settings.json
# (the project-level allowlist), the skills, the hooks that enforce the repo's
# non-negotiable conventions, and the path-scoped area rules, so the team gets
# the same defaults.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/hooks/
!.claude/rules/
!.claude/launch.json
.claude/.session-state/

# Local-only issue snapshot (regenerate via scripts/dump-issues.sh)
ISSUES.md

# Balance-search study files (#345) — append-only trial logs, one per study.
# Local by default: they grow with every evaluation. `git add -f` a study
# deliberately when it is the evidence behind a calibration commit.
studies/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
