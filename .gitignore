.env*.local

# Claude Code: ignore everything personal/local, but share settings.json
# (the project-level allowlist) so the team gets the same defaults.
.claude/*
!.claude/settings.json
!.claude/skills/

# Local-only issue snapshot (regenerate via scripts/dump-issues.sh)
ISSUES.md

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
